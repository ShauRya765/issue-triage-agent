# Required for extract nodes. Without it, extract fails closed (returns {}).
ANTHROPIC_API_KEY=

# Optional but recommended: raises GitHub's unauthenticated rate limit
# (60/hr -> 5000/hr). The reporter-context lookup uses the search API, which is
# limited far harder -- 10 requests/minute unauthenticated vs 30 authenticated
# -- so without a token that lookup starts failing (degrading to unknown, which
# suppresses escalation) after a handful of issues in one batch.
GITHUB_TOKEN=

# Postgres connection string for LangGraph's checkpointer. Required to run
# the API (durable interrupt/resume needs a real checkpoint store).
#
# Supabase: Project -> Connect -> copy a Postgres URI and replace [YOUR-PASSWORD]
# with the database password (Settings -> Database -> Reset database password if
# you don't have it). Any of the three work; they differ in how they pool:
#
#   Direct        db.<ref>.supabase.co:5432                 IPv6 only
#   Session pool  aws-0-<region>.pooler.supabase.com:5432   IPv4, one conn per client
#   Transaction   aws-0-<region>.pooler.supabase.com:6543   IPv4, pgbouncer
#
# Prefer the session pooler for local dev. The transaction pooler also works --
# app/graph.py opens the connection with prepare_threshold=None so pgbouncer
# won't choke on prepared statements -- but it can't hold session state, so the
# session pooler is the safer default. Always keep sslmode=require.
#
# This is the service-role-equivalent database password: it bypasses RLS. Keep
# it in .env (gitignored), never in client code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase: other variables you may see, and why they're not here ---
# The dashboard also gives you SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY and SUPABASE_JWKS_URL (formerly the anon / service_role
# pair). Those authenticate to Supabase's HTTP APIs -- PostgREST, Auth, Storage.
# This project doesn't use them: LangGraph's PostgresSaver speaks the Postgres
# wire protocol, not REST, because it creates tables and writes checkpoint rows
# transactionally. So DATABASE_URL above is the only Supabase value read here,
# and its password is a separate credential from any sb_secret_... key.
#
# Keeping the others in .env is harmless, but SUPABASE_SECRET_KEY bypasses RLS
# -- it belongs on a server, never in anything shipped to a browser.

# claude-sonnet-5 via langchain_anthropic.
MODEL=claude-sonnet-5

REPO=vercel/next.js

# vercel/next.js labels components as bare names (Turbopack, Runtime, ...),
# not a "area:" prefix, so this is empty by default. Kept as a knob for repos
# that do use a prefix (e.g. LABEL_PREFIX=area: -> "area: routing").
LABEL_PREFIX=

# Comma-separated. Matched case-sensitively against real vercel/next.js
# component labels found in scripts/check_labels.py. See README for how this
# list was derived.
COMPONENTS=Turbopack,Runtime,Performance,Dynamic Routes,Output,Linking and Navigating,Middleware,Internationalization (i18n),TypeScript,Cache Components,Webpack,Error Overlay,Headers,Parallel & Intercepting Routes,Metadata,Redirects,Module Resolution,Pages Router,Not Found,Form (next/form),Cookies,create-next-app,Script (next/script),SWC,React,Route Handlers

# Default true: no writes to GitHub, actions return descriptive strings.
SHADOW_MODE=true

# Default false: every run stops for human approval, whatever the routing gate
# decides. Set true to let the agent execute the cases policy.review_reason
# positively clears -- currently: not a P0, component confidently identified,
# label-only (no comment to a reporter), and reporter context successfully
# looked up. Everything else still pauses. Turn this on only together with a
# repo you own; AUTONOMOUS=true with SHADOW_MODE=false writes to GitHub with
# nobody watching.
AUTONOMOUS=false
